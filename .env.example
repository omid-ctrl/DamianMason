# ---------------------------------------------------------------------------
# damianmason.com
#
# Copy to .env.local for local overrides. The site builds, runs and deploys
# with every one of these unset, so nothing here is required to get started.
# Only .env.example is committed; .gitignore keeps every other .env file out.
#
# On Vercel these are set per environment in Project Settings, Environment
# Variables. NEXT_PUBLIC_SITE_URL is read at BUILD time, so changing it there
# needs a redeploy, not a restart.
# ---------------------------------------------------------------------------


# The production origin. Every canonical URL, Open Graph URL, JSON-LD URL,
# robots.txt Host and sitemap.xml entry is built from this one value, so it is
# the only thing to change if the site ever moves. A trailing slash is stripped
# for you.
#
# Unset, it falls back to https://damianmason.com, which is correct for
# production and correct for previews too: Vercel already sends previews
# X-Robots-Tag noindex, so pointing their canonicals at production is stable.
# VERCEL_URL is deliberately never consulted, because it names a throwaway
# per-deployment hostname.
#
# The NEXT_PUBLIC_ prefix is load-bearing. The nav components are client
# components that import content/site.ts, so the value has to reach the client
# bundle, and only NEXT_PUBLIC_ variables are inlined there.
NEXT_PUBLIC_SITE_URL=https://damianmason.com


# ---------------------------------------------------------------------------
# CONTACT FORM  (app/api/contact/route.ts)
#
# The endpoint never accepts a message it cannot deliver. With no provider
# configured it answers 501 no-provider-configured and the form falls back to
# the published email address and phone number, which is why leaving all of
# this unset is a supported state rather than a broken one.
#
# Two providers, tried in this order. Set ONE of them.
# ---------------------------------------------------------------------------

# --- Option 1: Resend. Both keys are required together. -------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=damianmasonoffice@gmail.com

# The From address. Left unset it uses Resend's shared sender, which works with
# no DNS setup at all. Point it at an address on damianmason.com once that
# domain is verified in Resend.
# CONTACT_FROM_EMAIL=website@damianmason.com

# --- Option 2: any endpoint that accepts a JSON POST. ---------------------
# Formspree, Web3Forms, a Zapier catch hook, a Make webhook, an internal
# service. The payload has a flat, stable shape: every key is always present.
# CONTACT_WEBHOOK_URL=https://formspree.io/f/xxxxxxxx

# Sent as `Authorization: Bearer ...` with the webhook post, when set.
# CONTACT_WEBHOOK_TOKEN=

# Web3Forms calls this access_key. Added to the payload only when set.
# CONTACT_WEBHOOK_ACCESS_KEY=


# ---------------------------------------------------------------------------
# BUILD ONLY. Not a deploy setting.
# ---------------------------------------------------------------------------

# The build output directory, read by next.config.ts. `npm run build:qa` sets
# it to a scratch path so a QA build never clobbers `.next`. Leave it unset
# everywhere else, including on Vercel.
# NEXT_DIST_DIR=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# An isolated distDir is the safe way to run `next build` while a dev server is
# reading /.next. Ignored so a throwaway build can never be committed, and so
# eslint does not try to lint several thousand generated chunks.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The example IS committed: it is the only record of which variables
# the contact form needs, and a deploy with none of them set is a real scenario
# the form handles, so the file has to travel with the code.
.env*
!.env.example

# vercel
.vercel

# QA artifacts: browser-automation output and route screenshots left by
# visual-check passes. Never part of the deploy.
.playwright-mcp/
/.playwright-cli/
/output/
/tmp/
/*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# Client-supplied originals and the harvested mirror of the old WordPress site.
# _source is reference material for content-parity checks, not deploy input.
/_source/html/
/_source/css/

# The harvested audio and video originals. 138MB across four files, all of them
# superseded: the three 1080p reels were transcoded to the 720p copies that ship
# in public/video, and the MP3 belonged to an inline player the rebuild dropped.
# Damian holds the masters. Carrying them in git history would cost every clone
# and every Vercel build 138MB to store encodes nothing references.
/_source/media/*.mp4
/_source/media/*.mp3

# The two media-kit archives recovered from the old WordPress library on
# 2026-08-07, 36MB between them. Everything worth having was extracted into
# _source/media-kit/ and every file in both, kept or not, is inventoried with a
# SHA-256 in _source/media-kit/PROVENANCE.md. Carrying the zips as well would
# store the same photographs twice, once compressed and once not.
/_source/archive/

# QA screenshots. 2,337 files and 1.47GB across eight audit rounds, every one of
# them regenerable with `node scripts/shoot.mjs`. The JSON reports and the
# measurement writeups beside them are kept, because those are the evidence.
/docs/qa/screenshots/
/docs/design/shots/


# Conflict copies. A file-sync client on this machine (the repo lives under
# ~/Desktop) writes "name 2.ext" beside a file it thinks diverged. One of those,
# a stale copy of tokens.css carrying the pre-revision palette, was swept into a
# commit by git add -A. They are never wanted in the tree.
*\ 2.*
*\ [0-9].*

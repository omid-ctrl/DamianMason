# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# An isolated distDir is the safe way to run `next build` while a dev server is
# reading /.next. Ignored so a throwaway build can never be committed, and so
# eslint does not try to lint several thousand generated chunks.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# QA artifacts: browser-automation output and route screenshots left by
# visual-check passes. Never part of the deploy.
.playwright-mcp/
/*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# Client-supplied originals and the harvested mirror of the old WordPress site.
# Kept out of the deploy bundle; _source is reference material for QA parity.
/_source/html/
/_source/css/
.DS_Store
